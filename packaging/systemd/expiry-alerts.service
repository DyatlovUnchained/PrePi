[Unit]
Description=PrepPi Daily Stock Expiry Alerts
After=network-online.target preppi.service
Wants=network-online.target

[Service]
Type=oneshot
User=preppi
Group=preppi
WorkingDirectory=/opt/preppi

Environment=PREPPI_DATA_DIR=/var/lib/preppi
Environment=PREPPI_CONFIG_DIR=/etc/preppi
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/preppi/venv/bin/python /opt/preppi/email/expiry_alerts.py --send

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/preppi /etc/preppi
