#!/usr/bin/python3

import json
import sqlite3
import subprocess
import sys
import time
from datetime import datetime, timedelta
from pathlib import Path

JOBS = {
    "receiver": {
        "timer": "preppi-email-receiver.timer",
        "service": "preppi-email-receiver.service",
    },
    "expiry": {
        "timer": "preppi-expiry-alerts.timer",
        "service": "preppi-expiry-alerts.service",
    },
    "monthly": {
        "timer": "preppi-monthly-report.timer",
        "service": "preppi-monthly-report.service",
    },
}

LEDGER = Path("/var/lib/preppi/email/email_log.db")


def systemctl(*args, timeout=15):
    return subprocess.run(
        ["systemctl", *args],
        capture_output=True,
        text=True,
        timeout=timeout,
        check=False,
    )


def property_value(unit, name):
    result = systemctl("show", unit, f"--property={name}", "--value")
    if result.returncode != 0:
        return ""
    value = result.stdout.strip()
    return "" if value in ("", "n/a", "unknown") else value


def next_receiver_check(timer):
    """Return the next systemd timer activation as local ISO time."""
    result = systemctl(
        "list-timers", "--all", "--no-pager", "--output=json"
    )

    if result.returncode != 0:
        return ""

    try:
        timers = json.loads(result.stdout)
    except (json.JSONDecodeError, TypeError):
        return ""

    for entry in timers:
        if entry.get("unit") != timer:
            continue

        next_usec = entry.get("next")
        if type(next_usec) is not int or next_usec <= 0:
            return ""

        try:
            return datetime.fromtimestamp(
                next_usec / 1_000_000
            ).astimezone().isoformat(timespec="minutes")
        except (OverflowError, OSError, ValueError):
            return ""

    return ""


def job_status(job_id, definition):
    timer = definition["timer"]
    service = definition["service"]

    enabled_result = systemctl("is-enabled", timer)
    active_result = systemctl("is-active", timer)

    enabled = enabled_result.stdout.strip() == "enabled"
    active = active_result.stdout.strip() == "active"

    last_run = property_value(service, "ExecMainStartTimestamp")
    result = property_value(service, "Result")
    exit_status = property_value(service, "ExecMainStatus")
    next_run = ""

    if job_id == "receiver":
        next_run = next_receiver_check(timer)
    else:
        next_run = property_value(timer, "NextElapseUSecRealtime")

    status = {
        "enabled": enabled,
        "active": active,
        "last_run": last_run,
        "next_run": next_run,
        "result": result,
        "exit_status": exit_status,
    }

    if job_id == "receiver":
        status.update({
            "last_check": last_run,
            "next_check": next_run,
            "last_result": "",
            "last_processed": "",
        })

        if LEDGER.exists():
            try:
                with sqlite3.connect(
                    f"file:{LEDGER}?mode=ro", uri=True
                ) as db:
                    row = db.execute("""
                        SELECT status, processed_at
                        FROM processed_emails
                        ORDER BY processed_at DESC
                        LIMIT 1
                    """).fetchone()

                if row:
                    status["last_result"], status["last_processed"] = row
            except sqlite3.Error:
                status["last_result"] = "unavailable"

    return status


def all_status():
    return {
        "available": True,
        "jobs": {
            job_id: job_status(job_id, definition)
            for job_id, definition in JOBS.items()
        },
    }


def main():
    args = sys.argv[1:]

    if args == ["status"]:
        print(json.dumps(all_status()))
        return 0

    if len(args) != 2:
        print(json.dumps({"error": "Invalid action"}))
        return 2

    action, job_id = args

    if action not in ("enable", "disable", "run", "preview"):
        print(json.dumps({"error": "Invalid action"}))
        return 2

    if job_id not in JOBS:
        print(json.dumps({"error": "Invalid job"}))
        return 2

    definition = JOBS[job_id]

    if action == "preview":
        preview_scripts = {
            "expiry": "/opt/preppi/email/expiry_alerts.py",
            "monthly": "/opt/preppi/email/monthly_report_sender.py",
        }
        if job_id not in preview_scripts:
            print(json.dumps({"error": "Preview is not supported for this job"}))
            return 2

        result = subprocess.run(
            [
                "runuser", "-u", "preppi", "--", "env",
                "PREPPI_DATA_DIR=/var/lib/preppi",
                "PREPPI_CONFIG_DIR=/etc/preppi",
                "/opt/preppi/venv/bin/python",
                preview_scripts[job_id],
            ],
            cwd="/opt/preppi",
            capture_output=True,
            text=True,
            timeout=180,
            check=False,
        )
        output = (result.stdout or "") + (result.stderr or "")
        print(json.dumps({
            "available": result.returncode == 0,
            "action": "preview",
            "job": job_id,
            "returncode": result.returncode,
            "output": output[-12000:],
        }))
        return 0 if result.returncode == 0 else 1

    if action == "enable":
        result = systemctl("enable", "--now", definition["timer"])
    elif action == "disable":
        result = systemctl("disable", "--now", definition["timer"])
    else:
        result = systemctl("start", definition["service"], timeout=180)

    if result.returncode != 0:
        print(json.dumps({
            "error": result.stderr.strip() or "Systemd command failed"
        }))
        return 1

    print(json.dumps(all_status()))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, subprocess.SubprocessError) as exc:
        print(json.dumps({"error": str(exc)}))
        sys.exit(1)
